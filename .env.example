# ── Wajib ──
API_KEY=your-secret-key-here

# ── Model ──
GGUF_MODEL_PATH=./models/llama-3.2-3b-instruct-q4_k_m.gguf
FALLBACK_MODEL_PATH=./models/llama-3.2-3b-instruct-q4_k_m.gguf
MODELS_CONFIG_PATH=./models/models_config_single.json

# ── RAG ──
CHROMA_PATH=./chroma_db
PDF_DIR=./documents
TOP_K=5

# ── LLM ──
TEMPERATURE=0.3
MAX_NEW_TOKENS=256
N_CTX=2048
BATCH_SIZE=512
LLM_TIMEOUT=120
N_THREADS=7
N_GPU_LAYERS=0

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT=10/minute
